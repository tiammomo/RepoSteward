  "info": {
    "title": "RepoSteward local workbench",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/code": {
      "get": {
        "operationId": "code",
        "parameters": [
          {
            "in": "query",
            "name": "project_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{32}$",
              "title": "Project Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "binding_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{32}$",
              "title": "Binding Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "evidence_id",
            "required": true,
            "schema": {
              "pattern": "^code:[0-9a-f]{64}$",
              "title": "Evidence Id",
              "type": "string"
            }
          },
          {
            "in": "query",
