{
  "name": "reposteward-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {"node": ">=22.12"},
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript openapi.json -o src/api/generated/schema.ts",
    "build": "npm run generate && tsc --noEmit && vite build",
    "check": "tsc --noEmit && eslint . && vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0",
    "eslint": "^9.39.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
